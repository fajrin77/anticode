# Salin ke .env — .env sudah di-gitignore.
# Isi hanya provider yang dipakai; provider tanpa kredensial ditandai di UI.
# Di rilis nanti kunci disimpan lewat OS credential store, bukan berkas ini.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

OPENAI_API_KEY=
OPENAI_MODEL=

GOOGLE_API_KEY=
GOOGLE_MODEL=

# Ollama tidak perlu kunci; ubah URL bila servernya tidak di mesin ini.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=

# Gateway OpenAI-compatible. BASE_URL wajib diisi — tidak ada nilai bawaan.
CLINEPASS_API_KEY=
CLINEPASS_BASE_URL=
# Model langganan tidak muncul di GET /models, jadi isi sendiri sekali di sini.
CLINEPASS_MODEL=
