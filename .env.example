# Copy to .env — .env is gitignored.
# anticode reads provider credentials from here OR from Settings → Providers
# (the Settings UI stores them sealed; .env is the headless/CI path).

# ── Clinepass gateway ────────────────────────────────────────────────
# The default provider: OpenAI-compatible gateway, hundreds of models.
CLINEPASS_API_KEY=
CLINEPASS_BASE_URL=
# Optional first model the composer suggests when the catalog is unreachable.
# CLINEPASS_MODEL=

# ── Anthropic API (official) ─────────────────────────────────────────
# Key format sk-ant-…; default model claude-opus-5.
# ANTHROPIC_API_KEY=

# ── OpenAI API (official) ────────────────────────────────────────────
# The catalog endpoint lists models; no model env is required.
# OPENAI_API_KEY=

# ── Google Gemini ────────────────────────────────────────────────────
# GOOGLE_API_KEY=

# ── Ollama (local, no key needed) ────────────────────────────────────
# Defaults to http://127.0.0.1:11434/v1 when unset.
# OLLAMA_BASE_URL=

# ── Session default ──────────────────────────────────────────────────
# Optional model id used when a session does not pick one.
# ANICODE_MODEL=
